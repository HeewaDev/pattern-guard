# Pattern-Guard Gateway example config. Full reference: docs/GATEWAY.md
#   pattern-guard-gateway --config gateway.toml --check   # validate
#   pattern-guard-gateway --config gateway.toml

listen = "0.0.0.0:8080"
upstream = "http://127.0.0.1:3000"     # your application

# "detect": log what would happen, never interfere (start here).
# "prevent": block, challenge and delay.
mode = "detect"

admin_listen = "127.0.0.1:9901"        # /metrics, /healthz, /inventory — keep private
# guard_config = "guard.toml"          # behavioural ML engine settings (optional)
max_body_bytes = 10485760
upstream_timeout_secs = 30
delay_max_secs = 5
forward_scores = true                  # x-pattern-guard-bot-score / -risk / -request-id to your app

[client_ip]
# Your load balancer / CDN. Only these peers may set the client-IP header; the client
# is the right-most address in it (all lines) that is not one of them. Your app then
# receives X-Forwarded-For: <client>, <trusted hops>, and X-Real-IP: <client>.
trusted_proxies = ["127.0.0.1"]
header = "x-forwarded-for"
# fingerprint_header = "x-ja4"         # if your TLS terminator adds a JA4 fingerprint

[limits]
max_connections_per_ip = 256
header_read_timeout_secs = 10          # slowloris protection

[waf]
enabled = true
block_score = 7.0                      # 0–10
log_score = 4.0
inspect_body_bytes = 65536
exclude_paths = ["/healthz"]
exclude_params = []                    # e.g. ["html_body"] for rich-text editors; a name
                                       # is excluded in every location and on every path

[challenge]
enabled = true
difficulty = 16                        # leading zero bits; ~0.1–0.5 s in a browser
ttl_secs = 3600
secret = ""                            # 64 hex chars; set it when running several instances

[access]
allow = []                             # never inspected
deny = []                              # always blocked
challenge = []                         # always challenged

# Shared IP reputation from CrowdSec (community blocklist + your local detections).
# cscli bouncers add pattern-guard-gateway   →  export CROWDSEC_BOUNCER_KEY=...
[crowdsec]
enabled = false
url = "http://127.0.0.1:8080"
api_key_env = "CROWDSEC_BOUNCER_KEY"
poll_secs = 10

# Network-layer (Suricata) and host-layer (Wazuh) detections enforced at the gateway.
# [[feeds]]
# kind = "suricata"
# path = "/var/log/suricata/eve.json"
# min_severity = 2                     # 1 = highest
# block_secs = 3600
#
# [[feeds]]
# kind = "wazuh"
# path = "/var/ossec/logs/alerts/alerts.json"
# min_severity = 10                    # rule level
# block_secs = 3600

[log]
decisions = "decisions.jsonl"          # EVE/ECS-like JSON lines for Wazuh / Elastic / Splunk
include_allowed = false

# ---- Custom rules: evaluated in order; the first allow/block/challenge/delay wins.
# Conditions (all optional, AND-ed): path, path_regex, methods, hosts, ips, not_ips,
# user_agent_regex, query_regex, headers = [{ name, regex | absent = true }].
# Actions: allow (skip all inspection), block, challenge, delay, log, skip_waf.
# [[rules]]
# name = "admin only from the office"
# path = "/admin"
# not_ips = ["10.0.0.0/8"]
# action = "block"
#
# [[rules]]
# name = "challenge known attack tools"
# user_agent_regex = "(?i)sqlmap|nikto|nuclei|masscan|zgrab"
# action = "challenge"
#
# [[rules]]
# name = "webhooks are signed, skip payload inspection"
# path = "/webhooks/"
# headers = [{ name = "x-signature" }]
# action = "skip_waf"

# ---- Rate limits (token bucket: `requests` per `per_secs`, bursts up to `requests`).
# key = "ip" | "ip_route" | "header:<name>"; action = "block" (429) | "challenge" | "delay".
# [[rate_limits]]
# name = "login attempts"
# path = "/login"
# methods = ["POST"]
# requests = 10
# per_secs = 60
#
# [[rate_limits]]
# name = "API per key"                  # each value gets its own bucket, and clients
# path = "/api/"                        # choose the values: pair it with an ip limit
# key = "header:x-api-key"
# requests = 600
# per_secs = 60
#
# [[rate_limits]]
# name = "API per IP"
# path = "/api/"
# requests = 1200
# per_secs = 60

# ---- Business operations: routes that move money or data. Identify the account with
# account = "header:<name>" | "cookie:<name>" | "query:<name>" | "form:<name>" |
# "json:<dotted.path>" (values are hashed, never stored; form: and json: fields are
# read from URL-encoded, multipart or JSON bodies, whatever the declared Content-Type,
# and form:name also matches a top-level JSON field). Checks: a budget per account
# (`limit`; key it on what your app authenticates, a session cookie or Authorization,
# not a public user name: a token comes back only if the request is not forwarded or
# your app answers 401 / 403), allowed sources (`allowed_ips`), replay protection
# (`unique`: a value such as a transaction id is accepted once; held while in flight,
# kept only after a 2xx answer). action = "block" | "challenge" | "delay" | "log".
# Answers: 429 + Retry-After (budget), 409 (replay), 403 (source / missing account).
# [[operations]]
# name = "checkout"
# path = "/checkout"
# methods = ["POST"]
# account = "header:authorization"
# limit = { requests = 5, per_secs = 3600 }
#
# [[operations]]
# name = "payment callback"
# path = "/payment/callback"
# allowed_ips = ["203.0.113.0/24"]      # your payment provider's published ranges
# unique = "json:transaction_id"
# unique_ttl_secs = 86400

# ---- Login protection: failed logins per account from any IP (distributed brute
# force) and distinct accounts failing from one IP (credential stuffing). Only
# failures (failure_statuses from your app) count. Defaults shown.
# [[logins]]
# name = "login"
# path = "/login"
# methods = ["POST"]
# account = "form:username"             # or "json:email"
# failure_statuses = [401, 403]
# max_failures = 5
# max_accounts_per_ip = 10
# window_secs = 900
# action = "challenge"                  # "block" lets anyone who knows a user name
#                                       # lock that account for the window

# ---- Automatic bans for repeat offenders (fail2ban-style). Banned IPs are refused
# outright; each repeat ban lasts `escalation` times longer. List / lift bans on the
# admin port: GET /bans, POST /bans/unban?ip=<address>.
[bans]
enabled = true
threshold = 10            # blocks ...
window_secs = 60          # ... within this many seconds
ban_secs = 600
escalation = 2.0
max_ban_secs = 86400

# ---- Honeypot traps: paths real visitors never request on *this* site.
# Requesting one bans the client immediately. Only list paths your app doesn't serve.
[traps]
paths = []                # e.g. ["/wp-login.php", "/xmlrpc.php", "/.env", "/phpmyadmin"]
ban_secs = 3600

# ---- HTTP protocol enforcement (OWASP CRS 911/920 ideas). Defaults shown.
[protocol]
enabled = true
allowed_methods = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]   # else 405
max_url_bytes = 8192          # else 414
max_headers = 100             # else 431
max_header_bytes = 32768      # else 431
max_query_args = 512          # else 400
block_null_bytes = true       # %00 in the target → 400
require_host = true
restricted_extensions = []    # e.g. [".bak", ".old", ".sql", ".swp", ".env", ".git"] → 403

# ---- Security headers on responses (only set when your app hasn't set them).
# An empty string disables a default.
[response_headers]
enabled = true
content_type_options = "nosniff"
frame_options = "SAMEORIGIN"
referrer_policy = "strict-origin-when-cross-origin"
strict_transport_security = ""     # e.g. "max-age=31536000; includeSubDomains" when served over HTTPS
content_security_policy = ""       # e.g. "default-src 'self'"
permissions_policy = ""
cross_origin_opener_policy = ""
remove = ["server", "x-powered-by", "x-aspnet-version", "x-aspnetmvc-version"]

# ---- Data-leak blocking on responses (opt-in: buffers text responses up to max_bytes).
# Catches SQL errors, PHP/Java/Python/.NET/Node stack traces, directory listings,
# private keys and AWS access keys. action = "block" (generic 500 page) | "log".
[response_inspection]
enabled = false
max_bytes = 262144
content_types = ["text/html", "text/plain", "application/json", "application/xml", "text/xml"]
action = "block"

# ---- Country access control. database = CSV of start_ip,end_ip,country_code, e.g.
# DB-IP "IP to Country Lite" (CC BY 4.0, attribution required): https://db-ip.com/db/lite.php
# Custom rules can also use `countries = ["..."]` once a database is set.
[geo]
# database = "dbip-country-lite.csv"
deny_countries = []
challenge_countries = []
allow_countries = []          # if set, every other (known) country is blocked
