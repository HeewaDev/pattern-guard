# Pattern-Guard Gateway example config. Full reference: docs/GATEWAY.md
#   pattern-guard-gateway --config gateway.toml --check   # validate
#   pattern-guard-gateway --config gateway.toml

listen = "0.0.0.0:8080"
upstream = "http://127.0.0.1:3000"     # your application

# "detect": log what would happen, never interfere (start here).
# "prevent": block, challenge and delay.
mode = "detect"

admin_listen = "127.0.0.1:9901"        # /metrics, /healthz, /inventory — keep private
# guard_config = "guard.toml"          # behavioural ML engine settings (optional)
max_body_bytes = 10485760
upstream_timeout_secs = 30
delay_max_secs = 5
forward_scores = true                  # x-pattern-guard-bot-score / -risk / -request-id to your app

[client_ip]
# Your load balancer / CDN. Only these peers may set the client-IP header.
trusted_proxies = ["127.0.0.1"]
header = "x-forwarded-for"
# fingerprint_header = "x-ja4"         # if your TLS terminator adds a JA4 fingerprint

[limits]
max_connections_per_ip = 256
header_read_timeout_secs = 10          # slowloris protection

[waf]
enabled = true
block_score = 7.0                      # 0–10
log_score = 4.0
inspect_body_bytes = 65536
exclude_paths = ["/healthz"]
exclude_params = []                    # e.g. ["html_body"] for rich-text editors

[challenge]
enabled = true
difficulty = 16                        # leading zero bits; ~0.1–0.5 s in a browser
ttl_secs = 3600
secret = ""                            # 64 hex chars; set it when running several instances

[access]
allow = []                             # never inspected
deny = []                              # always blocked
challenge = []                         # always challenged

# Shared IP reputation from CrowdSec (community blocklist + your local detections).
# cscli bouncers add pattern-guard-gateway   →  export CROWDSEC_BOUNCER_KEY=...
[crowdsec]
enabled = false
url = "http://127.0.0.1:8080"
api_key_env = "CROWDSEC_BOUNCER_KEY"
poll_secs = 10

# Network-layer (Suricata) and host-layer (Wazuh) detections enforced at the gateway.
# [[feeds]]
# kind = "suricata"
# path = "/var/log/suricata/eve.json"
# min_severity = 2                     # 1 = highest
# block_secs = 3600
#
# [[feeds]]
# kind = "wazuh"
# path = "/var/ossec/logs/alerts/alerts.json"
# min_severity = 10                    # rule level
# block_secs = 3600

[log]
decisions = "decisions.jsonl"          # EVE/ECS-like JSON lines for Wazuh / Elastic / Splunk
include_allowed = false

# ---- Custom rules: evaluated in order; the first allow/block/challenge/delay wins.
# Conditions (all optional, AND-ed): path, path_regex, methods, hosts, ips, not_ips,
# user_agent_regex, query_regex, headers = [{ name, regex | absent = true }].
# Actions: allow (skip all inspection), block, challenge, delay, log, skip_waf.
# [[rules]]
# name = "admin only from the office"
# path = "/admin"
# not_ips = ["10.0.0.0/8"]
# action = "block"
#
# [[rules]]
# name = "challenge known attack tools"
# user_agent_regex = "(?i)sqlmap|nikto|nuclei|masscan|zgrab"
# action = "challenge"
#
# [[rules]]
# name = "webhooks are signed, skip payload inspection"
# path = "/webhooks/"
# headers = [{ name = "x-signature" }]
# action = "skip_waf"

# ---- Rate limits (token bucket: `requests` per `per_secs`, bursts up to `requests`).
# key = "ip" | "ip_route" | "header:<name>"; action = "block" (429) | "challenge" | "delay".
# [[rate_limits]]
# name = "login attempts"
# path = "/login"
# methods = ["POST"]
# requests = 10
# per_secs = 60
#
# [[rate_limits]]
# name = "API per key"
# path = "/api/"
# key = "header:x-api-key"
# requests = 600
# per_secs = 60

# ---- Automatic bans for repeat offenders (fail2ban-style). Banned IPs are refused
# outright; each repeat ban lasts `escalation` times longer. List / lift bans on the
# admin port: GET /bans, POST /bans/unban?ip=<address>.
[bans]
enabled = true
threshold = 10            # blocks ...
window_secs = 60          # ... within this many seconds
ban_secs = 600
escalation = 2.0
max_ban_secs = 86400

# ---- Honeypot traps: paths real visitors never request on *this* site.
# Requesting one bans the client immediately. Only list paths your app doesn't serve.
[traps]
paths = []                # e.g. ["/wp-login.php", "/xmlrpc.php", "/.env", "/phpmyadmin"]
ban_secs = 3600

# ---- HTTP protocol enforcement (OWASP CRS 911/920 ideas). Defaults shown.
[protocol]
enabled = true
allowed_methods = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]   # else 405
max_url_bytes = 8192          # else 414
max_headers = 100             # else 431
max_header_bytes = 32768      # else 431
max_query_args = 512          # else 400
block_null_bytes = true       # %00 in the target → 400
require_host = true
restricted_extensions = []    # e.g. [".bak", ".old", ".sql", ".swp", ".env", ".git"] → 403

# ---- Security headers on responses (only set when your app hasn't set them).
# An empty string disables a default.
[response_headers]
enabled = true
content_type_options = "nosniff"
frame_options = "SAMEORIGIN"
referrer_policy = "strict-origin-when-cross-origin"
strict_transport_security = ""     # e.g. "max-age=31536000; includeSubDomains" when served over HTTPS
content_security_policy = ""       # e.g. "default-src 'self'"
permissions_policy = ""
cross_origin_opener_policy = ""
remove = ["server", "x-powered-by", "x-aspnet-version", "x-aspnetmvc-version"]
