# /etc/systemd/system/pattern-guard-gateway.service
# Setup: docs/DEPLOYMENT.md, section "systemd".
[Unit]
Description=Pattern-Guard Gateway
Documentation=https://github.com/HeewaDev/pattern-guard/blob/main/docs/GATEWAY.md
After=network-online.target
Wants=network-online.target

[Service]
User=pattern-guard
Group=pattern-guard
ExecStartPre=/usr/local/bin/pattern-guard-gateway --config /etc/pattern-guard/gateway.toml --check
ExecStart=/usr/local/bin/pattern-guard-gateway --config /etc/pattern-guard/gateway.toml
# `systemctl reload`: check the file, then reload it in place (docs/GATEWAY.md, "Reloading the config")
ExecReload=/usr/local/bin/pattern-guard-gateway --config /etc/pattern-guard/gateway.toml --check
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1
# On SIGTERM the gateway stops accepting, lets requests in progress finish for up to
# limits.shutdown_grace_secs (default 7) and writes the queued decision-log lines.
# Keep this a few seconds above shutdown_grace_secs.
TimeoutStopSec=20
# CROWDSEC_BOUNCER_KEY=... and other secrets
EnvironmentFile=-/etc/pattern-guard/env
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/log/pattern-guard
# To read Suricata / Wazuh alert files:
# ReadOnlyPaths=/var/log/suricata /var/ossec/logs/alerts

[Install]
WantedBy=multi-user.target
